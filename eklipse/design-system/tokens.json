{
  "$description": "Eklipse Media design tokens (W3C design-tokens style). Mirrors tokens.css.",
  "color": {
    "ink": {
      "950": { "$value": "#07070a", "$type": "color" },
      "900": { "$value": "#0e0e13", "$type": "color" },
      "800": { "$value": "#17171f", "$type": "color" },
      "700": { "$value": "#24242f", "$type": "color" },
      "500": { "$value": "#4a4a5a", "$type": "color" }
    },
    "moon": {
      "300": { "$value": "#a9adbd", "$type": "color" },
      "100": { "$value": "#e9e8ee", "$type": "color" }
    },
    "corona": {
      "400": { "$value": "#ffbe55", "$type": "color" },
      "500": { "$value": "#f4a62a", "$type": "color" },
      "700": { "$value": "#b06a00", "$type": "color" }
    },
    "semantic": {
      "bg": { "$value": "{color.ink.950}" },
      "surface": { "$value": "{color.ink.900}" },
      "text": { "$value": "{color.moon.100}" },
      "text-muted": { "$value": "{color.moon.300}" },
      "accent": { "$value": "{color.corona.500}" },
      "on-accent": { "$value": "{color.ink.950}" }
    }
  },
  "font": {
    "display": { "$value": "Bricolage Grotesque", "$type": "fontFamily" },
    "body": { "$value": "Inter", "$type": "fontFamily" }
  },
  "size": {
    "xs": "13px", "sm": "15px", "base": "17px", "lg": "20px",
    "xl": "26px", "2xl": "36px", "3xl": "40-60px fluid", "hero": "48-120px fluid"
  },
  "space": {
    "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "24px",
    "6": "32px", "7": "48px", "8": "64px", "9": "96px", "10": "144px"
  },
  "radius": { "sm": "6px", "md": "12px", "lg": "20px", "pill": "999px" },
  "motion": {
    "ease-out": "cubic-bezier(0.22, 1, 0.36, 1)",
    "fast": "150ms", "med": "280ms", "slow": "700ms"
  }
}
